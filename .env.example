# Telegram bot credentials
BOT_TOKEN=your_bot_token_from_botfather
# Optional: comma-separated numeric Telegram user IDs, e.g. 123456,789012.
# Leave empty to disable admin access until configured.
ADMIN_IDS=
BOT_USERNAME=your_bot_username

# Redis
REDIS_URL=redis://redis:6379/0

# Downloads and storage
DOWNLOAD_DIR=/tmp/tg_downloads
MAX_FILE_SIZE_MB=50
MAX_CONCURRENT_PER_USER=2
MAX_GLOBAL_CONCURRENT=10
ACTIVE_DOWNLOAD_TTL_SECONDS=3600
MAX_PLAYLIST_VIDEOS=5
COOKIE_EXPIRE_DAYS=30
FILE_EXPIRE_HOURS=24

# Application
DEFAULT_LANG=en
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
